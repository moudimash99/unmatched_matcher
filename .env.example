# Copy to .env (gitignored) and fill in. docker-compose reads it, and so does `python app.py`.
# SECRET_KEY: any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# sha256 of the tournaments password: python -c "import hashlib; print(hashlib.sha256(b'your password').hexdigest())"
TOURNAMENT_PASSWORD_HASH=
