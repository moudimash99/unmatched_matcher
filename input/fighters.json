  "playstyle_definitions": {
    "major": {
      "burst": "High damage in short windows",
      "adaptive": "Can change plan based on matchup/state",
      "control": "Dictates positioning/pace and constrains opponent",
      "scaling": "Becomes stronger over time through buildup",
      "evasion": "Avoids damage through positioning/timing",
      "rushdown": "Closes distance and pressures aggressively",
      "combo": "Relies on sequences/synergies for power spikes",
      "swarm": "Leverages multiple units/tokens for tempo",
      "attrition": "Wins by outlasting and resource draining",
      "resource_management": "Turns resources/tokens/cards into sustained advantage",
      "stance": "Shifts modes/identities for different benefits",
      "ranged_pressure": "Applies threat primarily from range"
    },
    "minor": {
      "resource_management": "Token/hand/option economy optimization",
      "combo": "Short tactical lines that chain effects",
      "rushdown": "Micro-level aggression and chase tools",
      "stance": "Mode toggles and timing decisions",
      "disruption": "Interferes with opponent plans/hand/position",
      "ranged_pressure": "Chip/threat from distance",
      "swarm": "Sidekick/token tempo plays",
      "burst": "Finishing windows and damage spikes",
      "evasion": "Slip, reposition, deny engagement",
      "technical": "High execution/precision sequencing",
      "attrition": "Small edges over time, sustain, depletion",
      "adaptive": "On-the-fly tactical pivots",
      "control": "Local zoning, traps, board shaping"
    }
  }
}